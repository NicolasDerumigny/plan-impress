<?xml version='1.0' encoding='UTF-8'?>
<!--
  Menu contribution for Plan Impress.

  How this is read (LibreOffice 26.x, framework/source/uielement/menubarmerger.cxx):
    * OfficeMenuBarMerging entries are applied to an existing menu bar.
      MergePoint is a menu path, elements separated by BACKSLASH, matched
      against the item commands (.uno:...) of that menu bar.
    * MergeCommand only accepts AddAfter | AddBefore | Replace | Remove.
    * MergeFallback only accepts AddPath | Ignore ("AddLast" is a *toolbar*
      merging token and is silently ignored here).
    * MergeContext is compared with StringRef::find() against the module
      identifier that ModuleManager::identify() returns for the document
      model - for Impress that is com.sun.star.presentation.PresentationDocument.
      A wrong value here fails silently: the menu simply never appears.
-->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons"
                    oor:package="org.openoffice.Office">
    <node oor:name="AddonUI">
        <node oor:name="OfficeMenuBarMerging">
            <node oor:name="org.nicolasderumigny.planimpress" oor:op="replace">
                <node oor:name="S1" oor:op="replace">
                    <prop oor:name="MergePoint">
                        <value>.uno:SlideShowMenu</value>
                    </prop>
                    <prop oor:name="MergeCommand">
                        <value>AddAfter</value>
                    </prop>
                    <prop oor:name="MergeFallback">
                        <value>AddPath</value>
                    </prop>
                    <prop oor:name="MergeContext" oor:type="xs:string">
                        <value>com.sun.star.presentation.PresentationDocument</value>
                    </prop>
                    <node oor:name="MenuItems">
                        <!-- The "Plan" menu itself: a popup needs a Title and a
                             Submenu, and must NOT carry a URL. -->
                        <node oor:name="M1" oor:op="replace">
                            <prop oor:name="Title" oor:type="xs:string">
                                <value xml:lang="en-US">Plan</value>
                                <value xml:lang="fr">Plan</value>
                            </prop>
                            <prop oor:name="Target" oor:type="xs:string">
                                <value>_self</value>
                            </prop>
                            <prop oor:name="Context" oor:type="xs:string">
                                <value>com.sun.star.presentation.PresentationDocument</value>
                            </prop>
                            <node oor:name="Submenu">
                                <!-- The rows of the popup, and the names are the
                                     ORDER: the configuration does not hand these
                                     children back in the order they are written here,
                                     it answers them with the node names compared
                                     NUMERICALLY.  With mm1..mm4, mm41, mm42, mm5, mm6
                                     in the file they came back as mm1, mm2, mm3, mm4,
                                     mm5, mm6, mm41, mm42, so the two section commands
                                     landed after *Toggle Debug Log* and its separator
                                     sat in the middle of the menu - "put the toggle
                                     debug log last with a separator in the menu".
                                     Keep the sequence fixed width: then the numeric
                                     order and the written order are the same
                                     (fact 98, dev/probe_menu_order.py).

                                     Three groups, in the order the deck is worked in:
                                     the two commands that put the plan slides in and
                                     take them out, the two that write the section
                                     names and take them back, then the two that
                                     change nothing in the deck - the option screen
                                     and the debug log.  The whole list is pinned by
                                     tests/run_tests.py::the_menu_groups_the_commands_
                                     in_the_order_the_deck_is_worked_in. -->
                                <node oor:name="mm01" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Insert Plan Slides</value>
                                        <value xml:lang="fr">Insérer les diapositives de plan</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.InsertPlan?insert</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                                <node oor:name="mm02" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Remove Plan Slides</value>
                                        <value xml:lang="fr">Supprimer les diapositives de plan</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.RemovePlan?remove</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                                <node oor:name="mm03" oor:op="replace">
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>private:separator</value>
                                    </prop>
                                </node>
                                <node oor:name="mm04" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Insert Section Titles</value>
                                        <value xml:lang="fr">Insérer des titres de section</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.SectionTitles?section_titles</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                                <node oor:name="mm05" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Remove Section Titles</value>
                                        <value xml:lang="fr">Supprimer les titres de section</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.RemoveSectionTitles?remove_section_titles</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                                <node oor:name="mm06" oor:op="replace">
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>private:separator</value>
                                    </prop>
                                </node>
                                <node oor:name="mm07" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Settings…</value>
                                        <value xml:lang="fr">Paramètres…</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.Settings?settings</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                                <node oor:name="mm08" oor:op="replace">
                                    <prop oor:name="Title" oor:type="xs:string">
                                        <value xml:lang="en-US">Toggle Debug Log</value>
                                        <value xml:lang="fr">Activer/désactiver le journal</value>
                                    </prop>
                                    <prop oor:name="URL" oor:type="xs:string">
                                        <value>service:org.nicolasderumigny.planimpress.Debug?debug</value>
                                    </prop>
                                    <prop oor:name="Target" oor:type="xs:string">
                                        <value>_self</value>
                                    </prop>
                                    <prop oor:name="Context" oor:type="xs:string">
                                        <value>com.sun.star.presentation.PresentationDocument</value>
                                    </prop>
                                </node>
                            </node>
                        </node>
                    </node>
                </node>
            </node>
        </node>

        <!-- Icons for the items above. %origin% is the extension's own folder. -->
        <node oor:name="Images">
            <node oor:name="org.nicolasderumigny.planimpress.insert.images" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.nicolasderumigny.planimpress.InsertPlan?insert</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/plan_16.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/plan_26.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="org.nicolasderumigny.planimpress.settings.images" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.nicolasderumigny.planimpress.Settings?settings</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/settings_16.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/settings_26.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="org.nicolasderumigny.planimpress.remove.images" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.nicolasderumigny.planimpress.RemovePlan?remove</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/remove_16.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/remove_26.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="org.nicolasderumigny.planimpress.section.images" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.nicolasderumigny.planimpress.SectionTitles?section_titles</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/section_16.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/section_26.png</value>
                    </prop>
                </node>
            </node>
            <node oor:name="org.nicolasderumigny.planimpress.section_remove.images" oor:op="replace">
                <prop oor:name="URL" oor:type="xs:string">
                    <value>service:org.nicolasderumigny.planimpress.RemoveSectionTitles?remove_section_titles</value>
                </prop>
                <node oor:name="UserDefinedImages">
                    <prop oor:name="ImageSmallURL" oor:type="xs:string">
                        <value>%origin%/icons/section_remove_16.png</value>
                    </prop>
                    <prop oor:name="ImageBigURL" oor:type="xs:string">
                        <value>%origin%/icons/section_remove_26.png</value>
                    </prop>
                </node>
            </node>
        </node>
    </node>
</oor:component-data>
